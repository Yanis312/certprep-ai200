generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Module {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  category    String
  order       Int
  createdAt   DateTime @default(now())
  units       Unit[]
}

model Unit {
  id        String     @id @default(cuid())
  slug      String     @unique
  title     String
  order     Int
  isLab     Boolean    @default(false)
  moduleId  String
  module    Module     @relation(fields: [moduleId], references: [id])
  questions Question[]
  progress  Progress[]
}

model Question {
  id            String   @id @default(cuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id])
  question      String
  options       String
  correctAnswer Int
  explanation   String
  createdAt     DateTime @default(now())
}

model Progress {
  id          String    @id @default(cuid())
  unitId      String
  unit        Unit      @relation(fields: [unitId], references: [id])
  score       Int       @default(0)
  totalQ      Int       @default(0)
  completed   Boolean   @default(false)
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}
